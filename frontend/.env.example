# Local development: set this to the exact port used by FastAPI.
# Production: set this to the public backend URL.
VITE_BACKEND_URL=http://127.0.0.1:8001
# Optional alias for the public backend URL. It takes precedence when set.
VITE_API_URL=

# Public Supabase project configuration; never put a secret/service-role key here.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=s