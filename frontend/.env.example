# Local development: set this to the exact port used by FastAPI, then restart Vite.
# Example: VITE_BACKEND_URL=http://127.0.0.1:8001
VITE_BACKEND_URL=http://127.0.0.1:8001
# Optional direct URL for separately deployed frontend/backend. When set, browser
# requests bypass the Vite proxy and use this URL directly.
VITE_API_URL=
